WITH persentase_gross_laba AS(
  SELECT
    fts.*,
    CASE
      WHEN fts.price <= 50000 THEN 0.10
      WHEN fts.price <= 100000 THEN 0.15
      WHEN fts.price <= 300000 THEN 0.20
      WHEN fts.price <= 500000 THEN 0.25
      ELSE 0.30
    END persentase_gross_laba
  FROM `rakamin-kf-analytics-508303.kimia_farma.kf_final_transaction` AS fts
)
SELECT 
  fts.transaction_id,
  fts.date,
  kc.branch_id,
  kc.branch_name,
  kc.kota,
  kc.provinsi,
  kc.rating AS rating_cabang,
  fts.customer_name,
  p.product_id,
  p.product_name,
  fts.price AS actual_price,
  fts.discount_percentage,
  persentase_gross_laba,
  fts.price * (1 - fts.discount_percentage) AS nett_sales,
  (fts.price * (1 - fts.discount_percentage)) * fts.persentase_gross_laba AS nett_profit,
  fts.rating AS rating_transaksi
FROM persentase_gross_laba AS fts
LEFT JOIN `rakamin-kf-analytics-508303.kimia_farma.kf_kantor_cabang` AS kc
  ON fts.branch_id = kc.branch_id
LEFT JOIN `rakamin-kf-analytics-508303.kimia_farma.kf_product` AS p
  ON fts.product_id = p.product_id
