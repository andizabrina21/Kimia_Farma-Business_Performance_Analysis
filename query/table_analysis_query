CREATE OR REPLACE TABLE `rakamin-kf-analytics-508303.kimia_farma.kf_table_analysis` AS

WITH customer_transaction AS (
  SELECT
    fts.*,
    COUNT(DISTINCT transaction_id) OVER (
      PARTITION BY customer_name
    ) AS total_transaction_customer
  FROM `rakamin-kf-analytics-508303.kimia_farma.kf_final_transaction` AS fts
),
calculated_final_transaction AS(
  SELECT
    ct.*,
    CASE
      WHEN ct.price <= 50000 THEN 0.10
      WHEN ct.price > 50000 AND ct.price <= 100000 THEN 0.15
      WHEN ct.price > 100000 AND ct.price <= 300000 THEN 0.20
      WHEN ct.price > 300000 AND ct.price <= 500000 THEN 0.25
      ELSE 0.30
    END gross_profit_percentage
  FROM customer_transaction AS ct
)
SELECT 
  cft.transaction_id,
  date,
  kc.branch_id,
  kc.branch_name,
  kc.kota AS city,
  kc.provinsi AS province,
  kc.rating AS branch_rating,
  cft.customer_name,
  p.product_id,
  p.product_name,
  cft.price AS actual_price,
  cft.discount_percentage,
  cft.gross_profit_percentage,
  cft.price * (1 - cft.discount_percentage) AS nett_sales,
  (cft.price * (1 - cft.discount_percentage)) * cft.gross_profit_percentage AS nett_profit,
  cft.rating AS transaction_rating,
  cft.total_transaction_customer,
  CASE
    WHEN cft.total_transaction_customer = 1 
      THEN 'One-time Customer'
    ELSE 'Repeat Customer'
  END AS transaction_frequency_group
FROM calculated_final_transaction AS cft
LEFT JOIN `rakamin-kf-analytics-508303.kimia_farma.kf_kantor_cabang` AS kc
  ON cft.branch_id = kc.branch_id
LEFT JOIN `rakamin-kf-analytics-508303.kimia_farma.kf_product` AS p
  ON cft.product_id = p.product_id
